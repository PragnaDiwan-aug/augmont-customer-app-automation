    }
    public double getSellingGoldRate() {
        // Locate the element containing "Selling at"
        WebElement sellingElement = driver.findElement(sellingRate);

        // Fetch full text from content-desc
        String contentDesc = sellingElement.getAttribute("content-desc");
        extentTestChild.info("Selling info text: " + contentDesc);

        // Clean and extract numeric value using replaceAll
        // Example text: "Selling at ₹ 11986.2  / gm\nValid for 05:00"
        String cleanedText = contentDesc
                .replaceAll("[^0-9.]", "")   // Remove everything except numbers and dot
                .trim();

        double sellingRate = 0.0;
        try {
            sellingRate = Double.parseDouble(cleanedText);
            extentTestChild.pass("Selling Gold Rate captured: ₹" + sellingRate + " / gm");
        } catch (NumberFormatException e) {
            extentTestChild.fail("Failed to parse selling rate from: " + cleanedText);
            Assert.fail("Invalid selling rate format: " + cleanedText);
        }

        Reporter.log("Selling Gold Rate: ₹" + sellingRate + " / gm", true);
        return sellingRate;
    }
    public double calculateAmountFromGoldGramsWithoutTax(double grams) {
        double sellingRate = getSellingGoldRate(); // ₹ per gram

        // Total amount without tax
        double totalAmount = sellingRate * grams;

        extentTestChild.info("Base Selling Rate: ₹" + sellingRate + " / gm");
        extentTestChild.pass("Total Amount (without tax): ₹" + totalAmount + " for " + grams + " gm");

        Reporter.log("Calculated Amount (without tax): " + grams + " gm → ₹" + totalAmount, true);

        return totalAmount;
    }


    
    public double getGoldValueAndVerify(double grams, double expectedAmount) {
        // XPath for Enter Grams input
    	WebElement gramInput = driver.findElement(By.xpath("//android.widget.EditText")); 
        // XPath for calculated amount display
        By calculatedAmount = By.xpath("//android.view.View[contains(@content-desc, '₹')]");

        gramInput.click();
        gramInput.clear();
        gramInput.sendKeys(String.valueOf(grams));

        // Wait until amount is updated
        Wait<AndroidDriver> wait = new FluentWait<>(driver)
                .withTimeout(Duration.ofSeconds(15))
                .pollingEvery(Duration.ofMillis(500))
                .ignoring(NoSuchElementException.class);
        WebElement amountField = wait.until(ExpectedConditions.visibilityOfElementLocated(calculatedAmount));

        // Get amount from content-desc and parse double
        String amountText = amountField.getAttribute("content-desc"); // Example: "= ₹ 10969008.40"
        amountText = amountText.replaceAll("[^0-9.]", ""); // Remove everything except digits and dot
        double actualAmount = Double.parseDouble(amountText);

        System.out.println("Calculated Gold Value for " + grams + " gm: ₹" + actualAmount);

        // Verification
        Assert.assertEquals(actualAmount, expectedAmount, 0.01, "Calculated amount mismatch!");

        return actualAmount;
    }

       
    public double verifyWithdrawlGramLessThanRemaining() {
        // Step 1: Get the current remaining gold value
        double remainingGold = getRemainingValueInGram();
        double lesserValueThanRemaining = remainingGold - 1; // 1 gram less
        extentTestChild.info("Lesser Value in gram than Remaining: " + lesserValueThanRemaining);

        // Step 2: Locate and focus on the gram input field
        WebElement gramInput = driver.findElement(By.xpath("//android.widget.EditText"));
        gramInput.click();
        gramInput.clear();

        // Step 3: Type the smaller value (using AndroidKeyEvent for Flutter reliability)
        String value = String.valueOf(lesserValueThanRemaining);
        gramInput.sendKeys(String.valueOf(value));  
        return lesserValueThanRemaining;

    }

