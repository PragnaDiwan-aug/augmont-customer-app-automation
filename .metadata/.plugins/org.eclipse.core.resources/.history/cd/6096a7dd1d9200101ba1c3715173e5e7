	public void enterOtpRazorPay(String otp) {
		
		try {
			Thread.sleep(5000);
		} catch (InterruptedException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
	    JavascriptExecutor js = (JavascriptExecutor) driver;

	    // Count OTP input fields using XPath
	    Long inputCount = (Long) js.executeScript(
	        "return document.evaluate(\"count(//input[@name='otp'])\", document, null, XPathResult.NUMBER_TYPE, null).numberValue;"
	    );

	    if (inputCount == 1) {
	        // Single field OTP
	        js.executeScript(
	            "var el = document.evaluate(\"//input[@name='otp']\", document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;" +
	            "el.value='" + otp + "';" +
	            "el.dispatchEvent(new Event('input', { bubbles: true }));"
	        );
	    } else if (inputCount > 1) {
	        // Multiple boxes OTP
	        for (int i = 0; i < otp.length() && i < inputCount; i++) {
	            String script = 
	                "var el = document.evaluate(\"(//input[@name='otp'])[" + (i+1) + "]\", document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;" +
	                "el.value='" + otp.charAt(i) + "';" +
	                "el.dispatchEvent(new Event('input', { bubbles: true }));";
	            js.executeScript(script);
	        }
	    } else {
	        throw new RuntimeException("No OTP input fields found using //input[@name='otp']");
	    }
	}

	public void verifyPaymentAmountOnPaymentPage(double expectedAmount) {
	    // Wait with FluentWait to locate the element
	    Wait<AndroidDriver> wait = new FluentWait<>(driver)
	        .withTimeout(Duration.ofSeconds(40))
	        .pollingEvery(Duration.ofMillis(500))
	        .ignoring(NoSuchElementException.class);	    

	    WebElement element = wait.until(driver -> driver.findElement(paymentAmountEle));

	    // Fetch and print raw text from UI
	    String rawAmount = element.getText(); 
	    System.out.println("Raw Amount Text: " + rawAmount);

	    // Clean and parse the string
	    String cleanAmount = rawAmount.replaceAll("[^0-9.]", "");
	    BigDecimal actualAmount = new BigDecimal(cleanAmount).setScale(2, RoundingMode.DOWN);
	    BigDecimal expectedAmountBD = BigDecimal.valueOf(expectedAmount).setScale(2, RoundingMode.HALF_UP);
	    System.out.println("Parsed Actual Amount: ₹" + actualAmount);
	    System.out.println("Expected Amount: ₹" + expectedAmountBD);

	    // Compare
	    if (actualAmount.compareTo(expectedAmountBD) == 0) {
	        Reporter.log("✅ Payment Amount Verified on Payment Page: ₹" + actualAmount, true);
	        extentTestChild.pass("Payment Amount Verified on Payment Page: ₹" + actualAmount);
	    } else {
	        Reporter.log("❌ Payment Amount Mismatch on Payment Page. Expected: ₹" + expectedAmountBD + ", Found: ₹" + actualAmount, true);
	        extentTestChild.fail("Payment Amount Mismatch on Payment Page. Expected: ₹" + expectedAmountBD + ", Found: ₹" + actualAmount);
	    }
	}
	
