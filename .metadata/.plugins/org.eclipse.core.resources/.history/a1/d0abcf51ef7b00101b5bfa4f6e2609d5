# Use official Maven + Java 17 image
FROM maven:3.9.6-eclipse-temurin-17

# Install basic tools, Node.js 22, and Android tools
RUN apt-get update && apt-get install -y \
    curl unzip git wget gnupg apt-transport-https \
    android-tools-adb \
    xvfb \
    x11vnc \
    fluxbox \
    net-tools \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g appium@2.17.1 appium-uiautomator2-driver \
    && apt-get clean

# Set display environment for VNC
ENV DISPLAY=:99

# Create working directory
WORKDIR /app

# Copy only pom.xml first to cache Maven dependencies
COPY pom.xml /app/

# Pre-download Maven dependencies
RUN mvn dependency:go-offline -B

# Copy the rest of the project
COPY . /app
COPY src ./src
COPY config /app/config
COPY testdata ./testdata
COPY xmlfiles ./xmlfiles

# Copy entrypoint script and make it executable
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Default Payment Gateway (can be overridden via ENV)
ENV PG=RazorPay

# Expose ports for Appium and VNC
EXPOSE 4723 6080

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]