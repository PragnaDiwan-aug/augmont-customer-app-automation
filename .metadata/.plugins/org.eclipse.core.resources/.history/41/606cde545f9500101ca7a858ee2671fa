	@Test()
	public void buySilver_ValidateOrder_TC001() throws IOException
	{	
		extentTest=extentReports.createTest("Buy Silver (One-Time) in Amount with Manually Enter Value, Payment Done using Netbanking, Then Validate Order Details");
		extentTest.info("buySilver_ValidateOrder_TC001");
		extentTest.assignCategory("Silver Purchase - Transaction Verification");
		loginMethod.login();
		addWalletBalanceMethod.verifyWalletAmountIsZero();
		purchaseMethod.buySilverOneTimeWithManuallyEnteredAmount();
		purchaseMethod.varifypurchaseSummaryForManuallyEnteredAmountOption(0.0);
		paymentMethod.partialPaymentMethodUsingNetBanking(PaymentPage.congratulationMsg,PaymentPage.BuySilvermessage,purchaseSummaryPage.calculateAndPrintNetPayable());
		transactionMethod.getTransactionAmountFromHistoryForSilver(PurchaseSummaryPage.totalPurAmount);
	}
	
