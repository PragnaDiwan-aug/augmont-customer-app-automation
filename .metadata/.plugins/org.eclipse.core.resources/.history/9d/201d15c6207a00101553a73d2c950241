    @BeforeMethod
    public void setUp(String PG) throws IOException {
        PaymentGateway = PG;

        // Load properties
        prop = new Properties();
        FileInputStream fis = new FileInputStream(System.getProperty("user.dir") + "/Config/data.properties");
        prop.load(fis);

        String ipAddress = System.getProperty("ipAddress") != null ? System.getProperty("ipAddress") : prop.getProperty("ipAddress");
        String port = prop.getProperty("port");
        String apkPath = prop.getProperty("apkPath");

        // Determine Appium JS path based on version
        File appiumJs = new File("/usr/local/lib/node_modules/appium/appium.js"); // Appium 2.x path
        if (!appiumJs.exists()) {
            // fallback for Appium 1.x
            appiumJs = new File("/usr/local/lib/node_modules/appium/build/lib/main.js");
        }

        // Start Appium service
        service = new AppiumServiceBuilder()
                .withAppiumJS(appiumJs)
                .withIPAddress(ipAddress)
                .usingPort(Integer.parseInt(port))
                .withArgument(GeneralServerFlag.ALLOW_INSECURE, "adb_shell,chromedriver_autodownload")
                .build();
        service.start();

        // Set Android options
        UiAutomator2Options options = new UiAutomator2Options()
                .setDeviceName("android34")
                .setApp(apkPath)
                .setAutomationName("UiAutomator2")
                .setAppWaitActivity("*")
                .setAppWaitDuration(Duration.ofSeconds(60))
                .setAutoGrantPermissions(true)
                .setNoReset(false)
                .setFullReset(false)
                .amend("unicodeKeyboard", true)
                .amend("resetKeyboard", true)
                .amend("uiautomator2ServerInstallTimeout", 60000)
                .amend("adbExecTimeout", 60000)
                .amend("chromedriver_autodownload", true);

        driver = new AndroidDriver(new URL("http://localhost:4723"), options);

        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
        wait = new WebDriverWait(driver, Duration.ofSeconds(20));

        // small delay to stabilize
        try { Thread.sleep(5000); } catch (InterruptedException e) { e.printStackTrace(); }
    }


    @AfterMethod
    public void afterTest(ITestResult result) throws IOException {
        Reporter.log("******* Test is about to end *******", true);

        if (result.getStatus() == ITestResult.FAILURE) {
            extentTest.fail("Test Failed Name -> " + result.getName() + "<br/>" +
                    "Failed Test logs -> " + result.getThrowable(),
                    MediaEntityBuilder.createScreenCaptureFromPath(Helper.captureScreenShots(driver, result.getName())).build());
        } else if (result.getStatus() == ITestResult.SKIP) {
            extentReports.removeTest(extentTest);
        }

        extentReports.flush();
        testAssert.assertAll();

        if (driver != null) driver.quit();
        if (service != null && service.isRunning()) service.stop();


        Reporter.log("******* Test completed >> Report Path: " + System.getProperty("user.dir"), true);
    }
