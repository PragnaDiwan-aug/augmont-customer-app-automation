    public String getToken(String requestUri) {

        extentTestChild = extentTest.createNode("Get Token");
        extentTestChild.info("Sending token request...");

        String token = null;

        try {
            // Step 1: Prepare request
            RequestSpecification httpRequest = RestAssured.given();

            // Step 2: Construct JSON body
            JSONObject requestParams = new JSONObject();
            requestParams.put("pin", "123456");
            requestParams.put("verifyByPin", true);
            requestParams.put("mobileNumber", "8141143966");
            requestParams.put("deviceId", null);  // Optional

            Reporter.log("Request body: " + requestParams.toJSONString(), true);
            extentTestChild.info("Request body: " + requestParams.toJSONString());

            httpRequest.header("Content-Type", "application/json");
            httpRequest.body(requestParams.toJSONString());

            // Step 3: Send POST request
            Response response = httpRequest.request(Method.POST, requestUri);
            int statusCode = response.getStatusCode();
            extentTestChild.info("Status Code: " + statusCode);

            if (statusCode != 200) {
                extentTestChild.fail("API returned non-200 response: " + statusCode);
                Assert.fail("API failed with HTTP code: " + statusCode);
            }

            // Step 4: Parse and log response
            String responseBody = response.getBody().prettyPrint();
            extentTestChild.info("Response body: " + responseBody);

            JsonPath jsonPath = response.jsonPath();

            // Step 5: Extract token
            if (jsonPath.get("token") != null) {
                token = jsonPath.getString("token");
                extentTestChild.pass("Token received: " + token);
                Reporter.log("Token: " + token, true);
            } else {
                extentTestChild.fail("Token not found in response");
                Assert.fail("Token key not present in response JSON");
            }

        } catch (Exception e) {
            extentTestChild.fail("Exception during getToken(): " + e.getMessage());
            Assert.fail("Error in getToken(): " + e.getMessage());
        }

        Reporter.log("********************* finish line **************************", true);
        return token;
    }
    
    
    
