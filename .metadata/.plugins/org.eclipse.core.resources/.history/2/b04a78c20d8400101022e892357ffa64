	@Test()
	public void buySilver_ValidateOrder_TC005()
	{	
		extentTest=extentReports.createTest("Add Funds to Wallet,Buy Silver (One-Time), Pay Fully via Wallet, and Validate Order Details");
		extentTest.info("buyGold_ValidateOrder_TC005");
		extentTest.assignCategory("Silver Purchase - Transaction Verification");
		loginMethod.login();
		try {
			addWalletBalanceMethod.AddWalletBalanceUsingWallet(50);
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		transactionMethod.validateWalletAmountFromTransactionLog(getExcelData.getNumaricDataInt("PurchaseData",2,6));
